# Copie ce fichier vers .env puis relance npm run dev.
# .env est ignoré par git — n'y remets jamais de clé dans .env.example.

# --- Backend crk-backend -------------------------------------------------
# Laisser VIDE en dev : le client appelle /api/... et le proxy de vite.config.js
# route vers CRK_BACKEND_URL. Ne renseigner VITE_API_URL que pour taper un
# backend distant directement depuis le navigateur (le backend doit alors
# autoriser l'origine du dashboard via CRK_ALLOWED_ORIGINS).
VITE_API_URL=

# Cible du proxy de développement (port par défaut de crk-backend : 8080)
CRK_BACKEND_URL=http://localhost:8080

# --- Rapports IA (page Rapports) ----------------------------------------
# Clé Gemini, gratuite : https://aistudio.google.com
# Sans clé, la page Rapports affiche une erreur explicite au lieu de générer.
VITE_GEMINI_API_KEY=
# Optionnel :
VITE_GEMINI_MODEL=gemini-3.5-flash

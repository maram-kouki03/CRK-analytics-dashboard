# Copier vers .env — .env est ignoré par git, n'y mets jamais de secret ici.

# Clé partagée avec les boîtiers caméra : exigée sur /ingest/*, en-tête X-API-Key.
CRK_API_KEY=change-me

# Base SQLite (relative au dossier crk-backend)
CRK_DB_PATH=./crk_analytics.db

CRK_HOST=0.0.0.0
# Éviter 8080 si un listener Oracle (TNSLSNR) tourne sur la machine : il occupe
# 127.0.0.1:8080 et uvicorn devient injoignable sans lever d'erreur.
CRK_PORT=8000

# Dashboard construit, servi par ce même service (donc same-origin, sans CORS).
# Défaut : ../Dashboard/dist. À renseigner si le build est ailleurs.
# CRK_DASHBOARD_DIST=C:\crk\dist

# Origines autorisées à appeler l'API depuis un navigateur (CORS), séparées par
# des virgules. Inutile en production tant que le dashboard est servi par ce
# service. Ne sert qu'au dev (Vite sur un autre port) ou à un frontend hébergé
# séparément.
# CRK_ALLOWED_ORIGINS=http://localhost:5173,https://dashboard.exemple.tn

# --- Repères de performance (spec Sales Potential) -----------------------
# Sales Potential = visiteurs x (CR_target / 100) x AB_reference
CRK_CR_TARGET_PCT=20
CRK_AB_REFERENCE=290

# --- Plage horaire affichee -----------------------------------------------
# Plage MINIMALE des graphes horaires, meme sans evenement (echelle stable).
# Ce n'est pas une borne : si des evenements arrivent a 21h ou 22h, la fenetre
# s'elargit automatiquement d'apres la base. Aucun evenement n'est replie.
CRK_OPEN_HOUR=9
CRK_CLOSE_HOUR=20

# --- API caisse Joolan ---------------------------------------------------
# Tant que ces trois valeurs sont vides, le dashboard simule les tickets et le
# chiffre d'affaires et affiche un bandeau orange. Des qu'elles sont renseignees,
# il bascule sur les vraies donnees et le bandeau disparait.
# Verifier avec :  py test_joolan.py
CRK_JOOLAN_DOMAIN=
CRK_JOOLAN_ENSEIGNE=
CRK_JOOLAN_API_KEY=

# Correspondance nom CRK -> code Magasin dans Joolan, en JSON.
# A remplir seulement si Joolan n'utilise pas les memes noms que STORE_NAMES.
# test_joolan.py affiche les codes reellement renvoyes.
# CRK_JOOLAN_MAGASINS={"MANAR CITY":"MANAR","Tunisia Mall":"TUNISMALL"}

# Natures d'entete comptees comme une vente (separees par des virgules).
# A CONFIRMER AVEC CRK : retours, avoirs, echanges, tickets de test.
CRK_JOOLAN_NATURES=VENTE

# http seulement si Joolan est installe en interne sans TLS. Defaut : https.
# CRK_JOOLAN_SCHEME=https
# CRK_JOOLAN_TIMEOUT=20
